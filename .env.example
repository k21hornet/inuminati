# Docker Registry
DOCKER_REGISTRY=your-registry.example.com
DOCKER_REGISTRY_REPOSITORY_NAME=your-registry.example.com/inuminati

# Image versions
BRAIN_VERSION=0.1.0
MUZZLE_VERSION=0.1.0

# MySQL
MYSQL_ROOT_PASSWORD=change-me
MYSQL_DATABASE=inuminati

# Brain (backend)
AUTH0_DOMAIN=your-tenant.auth0.com
AUTH0_AUDIENCE=https://your-api-identifier
CORS_ALLOW_ORIGINS=https://your-frontend.example.com
STORAGE_BASE_URL=https://your-storage.example.com
